<div class="min-h-screen text-slate-900 px-6 py-12">
  <div class="max-w-3xl mx-auto">
    
    <div class="mb-8">
      <%= link_to :back, class: "inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 hover:text-red-600 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back
      <% end %>
    </div>

    <div class="bg-white rounded-[2.5rem] shadow-sm border border-gray-100 p-8 md:p-16 relative overflow-hidden">
      <div class="absolute top-0 right-0 p-8 opacity-[0.03] pointer-events-none">
        <h1 class="text-9xl font-['Anton'] uppercase">Cinema</h1>
      </div>

      <div class="flex flex-col md:flex-row gap-12 items-start relative z-10">
        <div class="w-48 h-48 rounded-4xl overflow-hidden bg-[#0a0a0a] border border-gray-100 shadow-2xl shrink-0">
          <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar, class: "w-full h-full object-cover" %>
          <% else %>
            <div class="w-full h-full flex items-center justify-center bg-linear-to-br from-gray-900 to-black text-gray-700">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
          <% end %>
        </div>

        <div class="flex-1 space-y-8">
          <div>
            <p class="text-[10px] font-black uppercase tracking-[0.4em] text-red-600 mb-2">Member Profile</p>
            <h2 class="text-5xl font-['Anton'] uppercase tracking-tight leading-none text-slate-900">
              <%= @user.first_name %> <span class="text-gray-300"><%= @user.last_name %></span>
            </h2>
          </div>

          <div class="grid grid-cols-2 gap-8 border-t border-gray-50 pt-8">
            <div>
              <p class="text-[9px] font-black uppercase tracking-widest text-gray-400 mb-1">Identity</p>
              <p class="text-sm font-bold text-slate-700"><%= @user.gender || "Not specified" %></p>
            </div>
            <div>
              <p class="text-[9px] font-black uppercase tracking-widest text-gray-400 mb-1">Born</p>
              <p class="text-sm font-bold text-slate-700"><%= @user.birth_date&.strftime("%B %d, %Y") || "Not specified" %></p>
            </div>
          </div>

          <% if @user == current_user %>
            <div class="pt-4">
              <%= link_to edit_profile_path, class: "group relative inline-flex items-center justify-center p-0.5 overflow-hidden text-xs font-bold rounded-xl bg-gradient-to-br from-red-100 to-red-200 transition-all duration-300 transform active:scale-95" do %>
                <span class="relative px-8 py-3 rounded-[10px] bg-white text-gray-900 transition group-hover:bg-transparent group-hover:text-red-700 uppercase tracking-widest flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                  Edit profile
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-white p-8 rounded-4xl border border-gray-100 shadow-sm text-center group hover:border-red-100 transition-all duration-300">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gray-50 text-slate-900 mb-4 group-hover:bg-red-50 group-hover:text-red-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <p class="text-3xl font-['Anton'] text-slate-900 tracking-wider"><%= @user.watched_movies %></p>
        <p class="text-[9px] font-black uppercase tracking-[0.2em] text-gray-400 mt-1">Watched</p>
      </div>
      <div class="bg-white p-8 rounded-4xl border border-gray-100 shadow-sm text-center group hover:border-red-100 transition-all duration-300">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gray-50 text-slate-900 mb-4 group-hover:bg-red-50 group-hover:text-red-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <p class="text-3xl font-['Anton'] text-slate-900 tracking-wider"><%= @user.watchlist %></p>
        <p class="text-[9px] font-black uppercase tracking-[0.2em] text-gray-400 mt-1">Watchlist</p>
      </div>
      <div class="bg-white p-8 rounded-4xl border border-gray-100 shadow-sm text-center group hover:border-red-100 transition-all duration-300">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-gray-50 text-slate-900 mb-4 group-hover:bg-red-50 group-hover:text-red-600 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
          </svg>
        </div>
        <p class="text-3xl font-['Anton'] text-slate-900 tracking-wider"><%= @user.not_interested_movies %></p>
        <p class="text-[9px] font-black uppercase tracking-[0.2em] text-gray-400 mt-1">Ignored</p>
      </div>
    </div>
  </div>
</div>