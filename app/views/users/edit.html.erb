<div class="min-h-screen px-6 py-12">
  <div class="max-w-3xl mx-auto">
    
    <div class="mb-12 border-l-4 border-red-600 pl-6">
      <h2 class="text-5xl font-['Anton'] uppercase tracking-tight leading-none text-slate-900">
        Account <span class="text-red-600">Settings</span>
      </h2>
      <p class="text-slate-400 text-xs mt-2 uppercase tracking-[0.4em] font-bold">Here you can update your profile information</p>
    </div>

    <%= form_with model: @user, url: profile_path, local: true, class: "space-y-10" do |f| %>
    <% if @user.errors.any? %>
        <div class="mb-8 p-4 bg-red-50 border-l-4 border-red-600 rounded-r-xl">
            <h4 class="text-red-800 font-black uppercase text-xs mb-2">Wait! There are some errors:</h4>
            <ul class="list-disc list-inside text-red-600 text-[10px] font-bold uppercase tracking-wider">
            <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
            <% end %>
            </ul>
        </div>
    <% end %>
      <div class="relative group w-fit mx-auto md:mx-0">
        <div class="w-32 h-32 rounded-2xl overflow-hidden bg-[#0a0a0a] border border-gray-200 group-hover:border-red-600 transition-all duration-500 shadow-xl relative">
            
            <% if @user.avatar.attached? %>
            <%= image_tag @user.avatar, class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" %>
            <% else %>
            <div class="w-full h-full flex items-center justify-center bg-linear-to-br from-gray-900 to-black text-gray-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <% end %>
            
            <label class="absolute inset-0 bg-red-600/90 flex flex-col items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white mb-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            </svg>
            <span class="text-[8px] font-black uppercase tracking-widest text-white text-center">Change Photo</span>
            <%= f.file_field :avatar, class: "hidden", onchange: "this.form.requestSubmit()" %>
            </label>
        </div>
    </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        <div class="space-y-2">
          <%= f.label :first_name, "First Name", class: "text-[10px] font-black uppercase text-red-600 tracking-widest" %>
          <%= f.text_field :first_name, class: "w-full bg-transparent border-b border-black-300 focus:border-red-600 outline-none py-3 text-lg font-medium transition-all placeholder:text-gray-200 text-slate-800" %>
        </div>

        <div class="space-y-2">
          <%= f.label :last_name, "Last Name", class: "text-[10px] font-black uppercase text-red-600 tracking-widest" %>
          <%= f.text_field :last_name, class: "w-full bg-transparent border-b border-black-300 focus:border-red-600 outline-none py-3 text-lg font-medium transition-all placeholder:text-gray-200 text-slate-800" %>
        </div>

        <div class="space-y-2">
          <%= f.label :gender, "Gender Identity", class: "text-[10px] font-black uppercase text-red-600 tracking-widest" %>
          <%= f.select :gender, User::GENDERS, { include_blank: "Select identity" }, 
              class: "w-full bg-white border border-black-200 rounded-xl px-4 py-4 outline-none focus:border-red-600 appearance-none text-sm transition-colors cursor-pointer text-slate-700 shadow-sm" %>
        </div>

        <div class="space-y-2">
          <%= f.label :birth_date, "Birth Date", class: "text-[10px] font-black uppercase text-red-600 tracking-widest" %>
          <%= f.date_field :birth_date, class: "w-full bg-white border border-black-200 rounded-xl px-4 py-4 outline-none focus:border-red-600 text-sm transition-colors text-slate-700 shadow-sm" %>
        </div>
      </div>

      <div class="pt-10">
    <%= f.button type: :submit, 
            class: "group relative inline-flex items-center justify-center p-0.5overflow-hidden text-xs font-bold rounded-xl bg-gradient-to-br from-red-100 to-red-200 transition-all duration-300 hover:shadow-lg hover:shadow-red-100/50 transform active:scale-95 cursor-pointer" do %>
        <span class="relative px-12 py-4 rounded-[10px] bg-black text-white transition group-hover:bg-transparent group-hover:text-red-700 uppercase tracking-widest">
        Save Changes
        </span>
    <% end %>
    </div>

    <% end %>
  </div>
</div>