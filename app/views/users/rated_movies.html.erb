<div class="min-h-screen text-slate-900 px-6 py-12">
  <div class="max-w-6xl mx-auto">
    <div class="mb-8">
      <%= link_to user_path(@user), class: "inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-gray-400 hover:text-red-600 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Profile
      <% end %>
    </div>

    <div class="mb-12 text-center">
    <p class="text-[10px] font-black uppercase tracking-[0.4em] text-red-600 mb-2">My Ratings</p>
    <h1 class="text-5xl font-['Anton'] uppercase tracking-tight leading-none text-slate-900">
        <%= @user.first_name %>'s Ratings
    </h1>
    <p class="text-sm text-gray-500 mt-2">Movies & TV Shows</p>
    </div>

    <% if @rated_movies.any? %>
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-6">
        <% @rated_movies.each do |movie| %>
          <div class="group">
            <div class="aspect-2/3 bg-gray-900 rounded-2xl overflow-hidden mb-3 relative shadow-lg">
              <% if movie[:poster] %>
                <%= image_tag "https://image.tmdb.org/t/p/w500#{movie[:poster]}", 
                              class: "w-full h-full object-cover",
                              alt: movie[:title] %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center bg-linear-to-br from-gray-800 to-black">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
                  </svg>
                </div>
              <% end %>
              <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>
            </div>
            
            <h3 class="text-sm font-bold text-slate-900 mb-1 line-clamp-2"><%= movie[:title] %></h3>
            <% if movie[:year] %>
              <p class="text-xs text-gray-400 mb-2"><%= movie[:year] %></p>
            <% end %>
            
            <div class="flex gap-0.5 justify-start">
              <% 5.times do |i| %>
                <svg class="h-4 w-4 <%= i < movie[:user_movie].rating ? 'text-red-600' : 'text-gray-200' %>" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-4xl p-16 border border-gray-100 text-center">
        <p class="text-gray-400">No rated movies yet</p>
      </div>
    <% end %>
  </div>
</div>