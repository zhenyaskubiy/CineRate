<div class="min-h-screen bg-white text-black font-sans">
  <div class="relative min-h-[90vh] w-full overflow-hidden bg-black flex items-center">
    
    <% if @details['backdrop_path'].present? %>
      <div class="absolute inset-0">
        <img src="https://image.tmdb.org/t/p/original<%= @details['backdrop_path'] %>" 
             class="w-full h-full object-cover opacity-60 scale-105" alt="background">
        <div class="absolute inset-0 bg-linear-to-b from-black/80 via-transparent to-transparent"></div>
        <div class="absolute inset-0 bg-linear-to-t from-white via-transparent to-transparent"></div>
      </div>
    <% end %>
            
    <div class="relative z-10 w-full flex flex-col md:flex-row items-center justify-center px-6 md:px-20 gap-16">
      <div class="w-64 md:w-96 shrink-0 shadow-2xl rounded-[2.5rem] overflow-hidden border-2 border-white/20">
        <img src="https://image.tmdb.org/t/p/w500<%= @details['poster_path'] %>" class="w-full" alt="poster">
      </div>
      
      <div class="max-w-4xl flex flex-col items-center md:items-start w-full">
        
        <nav class="flex items-center justify-between w-full mb-12">
          <div class="flex gap-8 text-[13px] md:text-[15px] font-black uppercase tracking-[0.3em] text-white/70">
            <%= link_to "All Media", media_path, class: "hover:text-white transition-colors" %>
            <%= link_to "Trending", trending_path, class: "hover:text-white transition-colors" %>
            <%= link_to "Top 10", "#", class: "hover:text-white transition-colors" %>
          </div>

          <% if user_signed_in? %>
            <div class="relative" x-data="{ open: false }" @click.away="open = false">
              <button @click="open = !open" class="group flex items-center gap-3 focus:outline-none">
                <span class="hidden md:inline text-[10px] font-black uppercase tracking-widest text-white/50 group-hover:text-white transition-colors">
                  <%= current_user.full_name_upcase %>
                </span>
                <div class="w-10 h-10 rounded-xl overflow-hidden bg-black/40 border border-white/20 group-hover:border-red-600 transition-all duration-300 p-0.5">
                  <div class="w-full h-full rounded-[9px] overflow-hidden">
                    <% if current_user.avatar.attached? %>
                      <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
                    <% else %>
                      <div class="w-full h-full bg-gray-900 flex items-center justify-center text-white text-[10px] font-black">
                        <%= current_user.email[0].upcase %>
                      </div>
                    <% end %>
                  </div>
                </div>
              </button>

              <div x-show="open" 
                  x-transition:enter="transition ease-out duration-200"
                  x-transition:enter-start="opacity-0 scale-95 translate-y-[-10px]"
                  x-transition:enter-end="opacity-100 scale-100 translate-y-0"
                  class="absolute right-0 mt-3 w-56 origin-top-right rounded-2xl bg-white shadow-2xl border border-gray-100 py-2 z-50">
                <div class="px-4 py-3 border-b border-gray-50">
                  <p class="text-[10px] font-black uppercase tracking-widest text-red-600">Account</p>
                  <p class="text-xs font-bold text-slate-900 truncate"><%= current_user.full_name_upcase %></p>
                </div>
                <div class="py-1">
                  <%= link_to user_path(current_user), class: "flex items-center gap-3 px-4 py-3 text-xs font-bold text-slate-600 hover:bg-gray-50 hover:text-red-600 transition-colors" do %>
                    Profile
                  <% end %>
                  <%= link_to edit_profile_path, class: "flex items-center gap-3 px-4 py-3 text-xs font-bold text-slate-600 hover:bg-gray-50 hover:text-red-600 transition-colors" do %>
                    Settings
                  <% end %>
                </div>
                <div class="mt-1 border-t border-gray-50 pt-1">
                  <%= button_to destroy_user_session_path, method: :delete, class: "w-full flex items-center gap-3 px-4 py-3 text-xs font-bold text-red-500 hover:bg-red-50 transition-colors text-left" do %>
                    Sign Out
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </nav>

        <h1 class="text-6xl md:text-9xl font-['Anton'] uppercase leading-[0.9] tracking-tighter text-white drop-shadow-2xl">
          <%= @details['title'] || @details['name'] %>
        </h1>

        <div class="flex items-center gap-4 mt-8">
          <span class="bg-red-600 text-white px-5 py-1.5 rounded-full font-black text-sm uppercase shadow-lg">
            ★ <%= @details['vote_average']&.round(1) %>
          </span>
          <span class="text-white font-bold uppercase tracking-widest text-xs opacity-90">
            <%= (@details['release_date'] || @details['first_air_date'])&.split('-')&.first %> • 
            <%= @details['genres']&.map { |g| g['name'] }&.join(' / ') %>
          </span>
        </div>

        <div class="mt-10 pt-8 border-t border-white/10 w-full max-w-md">
          <%= turbo_frame_tag "media_status_btns_#{@details['id']}" do %>
            <% if flash[:notice] %>
              <div class="mb-6 p-4 rounded-2xl bg-white/5 border border-white/10 flex items-center gap-3 animate-in fade-in slide-in-from-top-2 duration-500">
                <div class="w-2 h-2 rounded-full bg-green-400 shadow-[0_0_10px_rgba(34,197,94,0.8)]"></div>
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-white">
                  <%= flash[:notice] %>
                </span>
              </div>
            <% end %>
            
            <% current_status = current_user.user_movies.find_by(tmdb_id: @details['id'])&.status %>   
            <% is_tv = @details['first_air_date'].present? || @details['number_of_seasons'].present? %>

            <% user_movie = current_user.user_movies.find_by(tmdb_id: @details['id']) %>
            <% current_rating = user_movie&.rating %> 

            <div class="grid grid-cols-3 gap-3 items-stretch">
              <% UserMovie.statuses.keys.each do |status_name| %>
                <%= button_to user_movies_path(
                      tmdb_id: @details['id'], 
                      status: status_name, 
                      media_type: is_tv ? 'tv' : 'movie'
                    ), 
                      method: :post, 
                      form_class: "m-0 h-full", 
                      class: "w-full h-full px-2 py-3 rounded-xl text-[9px] font-black uppercase tracking-widest transition-all 
                      text-center border-2 leading-tight flex items-center justify-center
                      #{current_status == status_name ? 'bg-white text-black border-white 
                      shadow-[0_0_20px_rgba(255,255,255,0.3)]' : 'bg-transparent text-white border-white/20 
                      hover:border-white hover:bg-white/10'}" do %>
                  <%= status_name.tr('_', ' ') %>
                <% end %>
              <% end %>
            </div>
            
            <% if current_status == 'watched' %>
                <div class="mt-6 pt-6 border-t border-white/10" x-data="{ 
                  selectedRating: <%= current_rating || 0 %>, 
                  hoverRating: 0,
                  isSubmitting: false
                }">
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-[10px] font-black uppercase tracking-[0.2em] text-white">
                      Your Rating
                    </span>
                    <span x-show="selectedRating > 0" 
                          class="text-[10px] font-black uppercase tracking-widest text-white bg-red-600/20 px-3 py-1 rounded-full border border-red-600/30">
                      <span x-text="selectedRating"></span> / 5
                    </span>
                  </div>
                  
                  <div class="flex items-center justify-center gap-2 py-4">
                    <template x-for="star in [1, 2, 3, 4, 5]" :key="star">
                      <%= form_with url: update_rating_user_movies_path, 
                                    method: :patch, 
                                    data: { turbo: false },
                                    html: { 
                                      class: "inline-block",
                                      "@submit": "isSubmitting = true"
                                    } do |f| %>
                        <%= hidden_field_tag :tmdb_id, @details['id'] %>
                        <%= hidden_field_tag :rating, nil, { 'x-model': 'star' } %>
                        
                        <button type="submit"
                                @mouseenter="hoverRating = star"
                                @mouseleave="hoverRating = 0"
                                :disabled="isSubmitting"
                                class="group relative transition-all duration-200 ease-out transform hover:scale-110 disabled:opacity-50 disabled:cursor-not-allowed">
                          <div class="absolute inset-0 rounded-full blur-md transition-opacity duration-200"
                              :class="(hoverRating >= star || selectedRating >= star) ? 'bg-red-600/40 opacity-100' : 'opacity-0'"></div>
                          
                          <svg class="w-10 h-10 md:w-12 md:h-12 relative transition-all duration-200" 
                              viewBox="0 0 24 24" 
                              fill="none"
                              :class="(hoverRating >= star || selectedRating >= star) ? 'drop-shadow-[0_0_8px_rgba(220,38,38,0.6)]' : ''">
                            <path x-show="hoverRating >= star || selectedRating >= star"
                                  d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" 
                                  :fill="hoverRating >= star ? 'rgb(220 38 38)' : 'rgb(239 68 68)'"
                                  class="transition-colors duration-150"/>
                            
                            <path x-show="hoverRating < star && selectedRating < star"
                                  d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" 
                                  stroke="rgba(255, 255, 255, 0.6)" 
                                  stroke-width="1.5"
                                  class="transition-all duration-150"/>
                          </svg>
                        </button>
                      <% end %>
                    </template>
                  </div>

                  <p x-show="selectedRating === 0" 
                    class="text-center text-[9px] font-bold uppercase tracking-widest text-white/40 mt-2">
                    Click a star to rate
                  </p>
                  <p x-show="selectedRating > 0" 
                    class="text-center text-[9px] font-bold uppercase tracking-widest text-white/60 mt-2">
                    Click to update rating
                  </p>
                </div>
              <% end %>

          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
      <div class="md:col-span-2">
        <h2 class="text-3xl font-['Anton'] uppercase mb-6 tracking-tight">Overview</h2>
        <p class="text-gray-600 text-lg leading-relaxed font-medium">
          <%= @details['overview'] %>
        </p>
      </div>
      <div class="bg-gray-50 p-8 rounded-4xl border border-gray-100 self-start">
        <h2 class="text-xs font-black uppercase mb-6 text-red-600 tracking-widest">Quick Info</h2>
        <ul class="space-y-4 text-sm">
          <li class="flex flex-col"><span class="text-[10px] uppercase font-bold text-gray-400">Status</span><span class="font-black uppercase text-xs"><%= @details['status'] %></span></li>
          <li class="flex flex-col"><span class="text-[10px] uppercase font-bold text-gray-400">Language</span><span class="font-black uppercase text-xs"><%= @details['original_language'] %></span></li>
          
          <% if @details['runtime'].present? && @details['runtime'] > 0 %>
            <li class="flex flex-col"><span class="text-[10px] uppercase font-bold text-gray-400">Duration</span><span class="font-black uppercase text-xs"><%= @details['runtime'] %> min</span></li>
          <% elsif @details['number_of_episodes'].present? %>
            <li class="flex flex-col">
              <span class="text-[10px] uppercase font-bold text-gray-400">Episodes</span>
              <span class="font-black uppercase text-xs"><%= @details['number_of_episodes'] %> eps</span>
            </li>
            <% if @details['episode_run_time']&.any? %>
              <li class="flex flex-col">
                <span class="text-[10px] uppercase font-bold text-gray-400">Total Est. Time</span>
                <span class="font-black uppercase text-xs">
                  <%= @details['episode_run_time'].first * @details['number_of_episodes'] %> min
                </span>
              </li>
            <% end %>
          <% end %>
        </ul>
        <%= link_to "← Back to Explore", :back, class: "mt-10 inline-block text-[10px] font-black uppercase tracking-widest border-b-2 border-black pb-1 hover:text-red-600 hover:border-red-600 transition-colors" %>
      </div>
    </div>
  </div>
</div>