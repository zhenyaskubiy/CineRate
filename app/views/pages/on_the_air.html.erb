<div class="min-h-screen relative px-6 py-10 md:px-12 text-black overflow-hidden">
  <style>
    @keyframes pulse {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(3%, 5%) scale(1.05); }
    }
  </style>

  <div class="flex flex-col items-center mb-8 text-center relative z-10">
    <div class="mb-8">
      <h2 class="text-4xl font-['Anton'] uppercase tracking-tighter text-black leading-none">
        <span class="text-red-600">On The Air</span> This Week
      </h2 >
      <p class="text-gray-400 font-bold uppercase tracking-[0.3em] text-[10px] mt-4">TV shows airing in the next 7 days</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto relative z-10">
    <% if @titles.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-x-10 gap-y-20">
        <% @titles.first(15).each do |title| %>
          <div class="w-full">
            <div class="group relative bg-white rounded-2xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.04)] transition-all duration-500 hover:shadow-[0_40px_80px_rgba(0,0,0,0.1)] hover:-translate-y-3 flex flex-col h-full border border-gray-50">
              <%= link_to media_item_path(type: 'tv', id: title['id']), data: { turbo: false }, class: "flex flex-col h-full no-underline" do %>
                <div class="aspect-2/3 relative overflow-hidden bg-gray-50">
                  <img src="https://image.tmdb.org/t/p/w500<%= title['poster_path'] %>" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
                  <div class="absolute top-3 left-3 bg-white/70 backdrop-blur-md px-3 py-1.5 rounded-xl shadow-sm">
                    <span class="text-black font-black text-[11px]">★ <%= title['vote_average']&.round(1) %></span>
                  </div>
                </div>
                <div class="p-4 flex flex-col">
                  <h3 class="text-black font-black text-xs uppercase truncate mb-3 tracking-tight group-hover:text-red-600 transition-colors"><%= title['name'] %></h3>
                  <div class="flex justify-between items-center">
                    <span class="text-gray-400 font-bold text-[10px] uppercase tracking-widest"><%= title['first_air_date']&.split('-')&.first %></span>
                    <span class="text-[9px] text-white bg-red-600 font-black uppercase px-2 py-1 rounded-md">NEW</span>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center text-gray-400">No shows on the air</div>
    <% end %>
  </div>

  <div class="mt-32 flex justify-center items-center gap-16 font-black uppercase text-[11px] relative z-10 pb-20">
    <% if @page > 1 %>
      <%= link_to "← Prev", on_the_air_path(page: @page - 1), class: "text-gray-400 hover:text-black transition-colors" %>
    <% end %>
    <div class="flex flex-col items-center">
      <span class="font-['Anton'] text-5xl leading-none text-black"><%= @page %></span>
    </div>
    <%= link_to "Next →", on_the_air_path(page: @page + 1), class: "text-gray-400 hover:text-black transition-colors" %>
  </div>
</div>