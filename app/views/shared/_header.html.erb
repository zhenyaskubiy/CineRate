<header class="bg-black text-white">
  <div class="max-w-7xl mx-auto px-6 py-4 space-y-4">
    <div class="grid grid-cols-3 items-center">
      <div></div>

      <div class="flex justify-center mt-6">
        <%= link_to "CINERATE",
            root_path,
            class: "text-6xl md:text-7xl lg:text-7xl
                    font-['Anton'] uppercase tracking-wide
                    hover:text-red-300 transition" %>
      </div>

      <div class="flex justify-end items-center gap-4">
        <% if user_signed_in? %>
          <span class="hidden md:inline text-xs font-medium text-gray-400">
            <%= current_user.full_name_upcase %>
          </span>

      <div class="relative" x-data="{ open: false }" @click.away="open = false">
          <button @click="open = !open" class="group relative focus:outline-none">
          <div class="w-10 h-10 rounded-xl overflow-hidden bg-[#0a0a0a] border border-gray-200 group-hover:border-red-600 transition-all duration-300 shadow-sm p-0.5">
            <div class="w-full h-full rounded-[9px] overflow-hidden bg-gray-900">
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-white text-[10px] font-black">
                  <%= current_user.email[0].upcase %>
                </div>
              <% end %>
            </div>
          </div>
        </button>
        <div x-show="open" 
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 scale-95 translate-y-[-10px]"
            x-transition:enter-end="opacity-100 scale-100 translate-y-0"
            x-transition:leave="transition ease-in duration-75"
            x-transition:leave-start="opacity-100 scale-100 translate-y-0"
            x-transition:leave-end="opacity-0 scale-95 translate-y-[-10px]"
            class="absolute right-0 mt-3 w-56 origin-top-right rounded-2xl bg-white shadow-2xl border border-gray-100 py-2 z-50"
            style="display: none;">
          
              <div class="px-4 py-3 border-b border-gray-50">
            <p class="text-[10px] font-black uppercase tracking-widest text-red-600">Account</p>
            <p class="text-xs font-bold text-slate-900 truncate"><%= current_user.full_name_upcase %></p>
          </div>
          <div class="py-1">

            <%= link_to user_path(current_user), class: "flex items-center gap-3 px-4 py-3 text-xs font-bold text-slate-600 hover:bg-gray-50 hover:text-red-600 transition-colors" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              Profile
            <% end %>

            <%= link_to edit_profile_path, class: "flex items-center gap-3 px-4 py-3 text-xs font-bold text-slate-600 hover:bg-gray-50 hover:text-red-600 transition-colors" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
              Edit Profile
            <% end %>

            <%= link_to "#", class: "flex items-center gap-3 px-4 py-3 text-xs font-bold text-slate-600 hover:bg-gray-50 hover:text-red-600 transition-colors" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
              </svg>
              My Watchlist
            <% end %>
          </div>
          <div class="mt-1 border-t border-gray-50 pt-1">
            <%= button_to destroy_user_session_path, method: :delete, class: "w-full flex items-center gap-3 px-4 py-3 text-xs font-bold text-red-500 hover:bg-red-50 transition-colors text-left" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              Sign Out
            <% end %>
          </div>
        </div>
      </div>
        <% else %>
          <%= link_to new_user_registration_path,
                      class: "group relative inline-flex items-center justify-center p-0.5
                              overflow-hidden text-xs font-medium rounded-xl
                              bg-gradient-to-br from-red-100 to-red-200" do %>
            <span class="relative px-5 py-2 rounded-xl bg-white text-gray-900 transition group-hover:bg-transparent">
              Get started
            </span>
          <% end %>
        <% end %>
      </div>

    </div>
    
   <nav class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-[11px] font-bold tracking-[0.2em]">
  <%= link_to "ALL MEDIA", media_path,
    class: "nav-link-animated transition whitespace-nowrap uppercase #{current_page?(media_path) ? 'text-red-500' : 'text-white hover:text-white'}" %>

  <%= link_to "TRENDING", trending_path,
    class: "nav-link-animated transition whitespace-nowrap uppercase #{current_page?(trending_path) ? 'text-red-500' : 'text-white hover:text-white'}" %>

  <%= link_to "TOP 10", "#",
    class: "nav-link-animated transition whitespace-nowrap uppercase text-white hover:text-white" %>

  <%= link_to "ABOUT", about_path,
    class: "nav-link-animated transition whitespace-nowrap uppercase #{current_page?(about_path) ? 'text-red-500' : 'text-white hover:text-white'}" %>
</nav>

  </div>
</header>

<div class="relative w-full overflow-hidden leading-0 bg-transparent">
  <svg 
    viewBox="0 0 390 20" 
    xmlns="http://www.w3.org/2000/svg" 
    class="relative block w-full h-5 md:h-10 text-black fill-current"
    preserveAspectRatio="none"
  >
    <path d="M0 0 C 100 20, 290 20, 390 0 L 390 0 L 0 0 Z"></path>
  </svg>
</div>